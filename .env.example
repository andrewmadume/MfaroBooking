# Server-only Supabase connection. Set these in local .dev.vars or runtime secrets.
SUPABASE_GATEWAY_URL=https://eijhlpsugkqfmbqgfhpp.supabase.co/functions/v1/mfarobooking-db
# Legacy anon JWT used only to pass the Edge Function's JWT gateway verification.
# The separate private application key authorizes database access.
SUPABASE_GATEWAY_ANON_KEY=your-project-anon-jwt
MFARO_DATABASE_KEY=your-private-64-character-hex-application-key
# With all Supabase settings absent, a DB binding provides the local D1 fallback.
# No SUPABASE_* or MFARO_DATABASE_KEY value should be prefixed NEXT_PUBLIC_.
# SANDBOX_WEBHOOK_SECRET=replace-with-a-long-random-server-side-secret
